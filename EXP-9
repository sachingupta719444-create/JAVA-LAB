class ReservationThread extends Thread{
    @Override
    public void run(){
        try{
            for(int i=1; i<=5; i++){
                System.out.println("Reservation Status : processing reservation " + i);
                Thread.sleep(500);
            }
        }
        catch(InterruptedException e){
            System.out.println("Reservation thread interrupted");
        }
    }
}

